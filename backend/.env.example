# Server Configuration
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# LLM & API Keys (Configure at least one LLM provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
DEFAULT_LLM_PROVIDER=openrouter

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# Vector Database (ChromaDB)
CHROMA_DB_DIR=./data/chroma_db

# Supabase Configuration (Optional external store)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Database Connection (Default: Fast local SQLite with full async support)
DATABASE_URL=sqlite+aiosqlite:///./data/asca.db

# JWT Authentication
JWT_SECRET=generate_a_secure_random_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
